---
layout: layouts/base.njk
---

<article class="max-w-4xl mx-auto px-4 py-12">
  <!-- Post Header -->
  <header class="mb-8 animate-fade-in-up">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">{{ title }}</h1>

    <div class="flex flex-wrap items-center text-gray-500 text-sm mb-4">
      <time datetime="{{ date | htmlDateString }}">
        {{ date | readableDate }}
      </time>
      <span class="mx-2">•</span>
      <span>{{ content | readingTime }} min read</span>

      {% if categories %}
      <span class="mx-2">•</span>
      <div class="flex gap-2">
        {% for category in categories %}
        <span class="bg-brand-green text-white px-3 py-1 rounded-full text-xs font-medium">
          {{ category }}
        </span>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </header>

  <!-- Post Content -->
  <div class="prose prose-lg max-w-none animate-fade-in animate-delay-2">
    {% if featured_image %}
    <figure class="float-right not-prose" style="width: 45%; margin: 0 0 1.5rem 2rem; shape-outside: margin-box;">
      <img src="{{ featured_image }}" alt="{{ title }}" class="w-full rounded-lg cursor-zoom-in" style="border: 3px solid #EDE8DF;" onclick="this.classList.toggle('zoomed')" />
    </figure>
    {% endif %}
    {{ content | safe }}
  </div>

  <!-- Post Footer -->
  <footer class="mt-12 pt-8 border-t border-gray-200">
    <a href="/blog/" class="text-brand-green hover:text-brand-green-light transition-colors font-medium">
      ← Back to all posts
    </a>
  </footer>
</article>
