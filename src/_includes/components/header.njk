<header class="bg-white border-b border-gray-200">
  <nav class="max-w-5xl mx-auto px-4 py-5">
    <div class="flex items-center justify-between">
      <a href="/" class="text-brand-green hover:text-brand-green-light transition-colors" style="font-family: 'Fredoka', sans-serif; font-size: 2rem;">
        {{ site.title }}
      </a>
      <ul class="flex items-center" style="gap: 4rem;">
        {% for item in site.navigation %}
        {% set isActive = (page.url == item.url) or (item.url == '/blog/' and '/blog/' in page.url) or (item.url == '/blog/' and '/posts/' in page.url) or (item.url == '/about/' and '/about/' in page.url) %}
        <li>
          <a href="{{ item.url }}" class="nav-link {% if isActive %}nav-link-active{% endif %}" style="font-size: 1.25rem; letter-spacing: 0.05em;">
            {{ item.title }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>
